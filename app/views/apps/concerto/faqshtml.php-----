<?php defined('BASEPATH') OR exit('No direct script access allowed');?>
<section class="uk-section withoulogin-faqs" uk-height-viewport="expand: true" style="background: none; padding-top: 33px;">
	<div class="uk-container">
      <h2>FAQs</h2>
      <hr>
      <div class="uk-child-width-1-3@s  uk-grid-match faq_categorySection" uk-grid>
      <?php if( !empty($lists) ) :    ?>
		    <?php foreach($lists as $list ) : ?>
                    <div class="">
                        <div class="uk-card uk-card-default uk-card-hover uk-card-body" style="cursor: pointer" onclick="window.location='<?php echo website_url('jtctools/faqs-subcategories/'.$list->catid.'-'.$list->catname); ?>'">
                            <img class="faq_categoryimage" src="<?php echo !empty($list->catimage) ?thumbnail_path('catimage/'.$list->catimage) : thumbnail_path(); ?>" style="width: 50px;" />
                            <h3 class="uk-card-title"><?php echo ($list->catname); ?></h3>
                            <p><?php echo substr($list->catdescription,0,200); ?>.</p>
                        </div>
                    </div>
            <?php endforeach; ?>
		<?php endif; ?>
        </div>
    </div>
</section>

<style>
.faq_categorySection .uk-card {
    text-align: center;
    box-shadow: none;
}
